            if safety_report:
                twitter_info = check_twitter_activity(token["Name"])
                if twitter_info:
                    token.update(safety_report)
                    token.update(twitter_info)
                    safe_tokens.append(token)
                    send_to_telegram_bot(token, bot_token, chat_id)
